# =============================================================================
# Source-only repository policy (inherited from tenchu-decomp, lsddecomp,
# parasite-eve-decomp and rage-racer-decomp).
#
# NOTHING copyrighted is ever committed: no disc images, no game executable,
# no extracted assets, no Sony Psy-Q SDK files, no compiler binaries.
# Contributors supply legally obtained copies; the build reads them from
# the git-ignored directories below.
# =============================================================================

# You provide these (git-ignored, never committed):
/disk/
/sdk/
/lib/
/include/psyq/
/assets/
/disc_j/
/disc_e/

# The retail executable(s) you verify against live here:
/baselines/*
!/baselines/.gitignore

# Build products:
/build/
*.o
*.obj
*.elf
*.map

# Community tools cloned or installed locally (pin exact revisions in your
# setup script instead of committing them):
/decomp-permuter/
/asm-differ/
/m2c/
/objdiff/
/.venv/
/venv/

# Python / editor / OS noise:
__pycache__/
*.pyc
.DS_Store
.idea/
.vscode/
*.swp
asm/header.s
mipsel-root/
tools-local/
tools-src/

# Permuter scratch (debug_source.c / debug_compiled_object.o are written
# into the CWD by decomp-permuter --debug):
/debug_source.c
/debug_compiled_object.o

# splat regenerates per-symbol nonmatching stubs for c rows under a nested
# nonmatchings/ path whenever extract runs after a flip; they are generated
# references, not sources, and no gate reads them (first noticed as 12
# accidentally committed SetVideoMode/GetVideoMode stubs in the VMODE
# commit, cleaned up alongside the GsGetActiveBuff match):
asm/*/nonmatchings/nonmatchings/
asm/nonmatchings/nonmatchings/
