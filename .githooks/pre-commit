#!/bin/sh
# =============================================================================
# pre-commit — protect the oracle.
#
# Distilled from lsddecomp's git hooks (rules 1-4):
#   * config/sha1/ holds the retail hash. Editing it to make a build pass
#     deletes the oracle. Blocked. (The one legitimate edit is the one-time
#     setup that records your real hash — see the message below.)
#   * Tracked asm/ files are generated by splat. Editing them corrupts the
#     oracle silently. Modifications and deletions are blocked; adding new
#     files (the normal outcome of `make extract`) is allowed.
#   * Nothing under disk/, sdk/, lib/, include/psyq/, assets/ or baselines/
#     may ever be committed (source-only repository policy).
#
# Install with:  make hooks
# =============================================================================
set -e

violations=0

# --- 1. The retail hash files are immutable ---------------------------------
sha1_hits="$(git diff --cached --name-only | grep -E '^config/sha1/' || true)"
if [ -n "$sha1_hits" ]; then
    echo "ERROR: this commit edits the oracle:" >&2
    echo "$sha1_hits" | sed 's/^/  /' >&2
    echo "" >&2
    echo "config/sha1/ holds the retail SHA-1. Changing it to make a build" >&2
    echo "pass deletes the oracle — a project without an oracle is just" >&2
    echo "paraphrase that no one can check." >&2
    echo "" >&2
    echo "Legitimate exception: the ONE-TIME setup that replaces the" >&2
    echo "placeholder with your retail hash. Triple-check it, then commit" >&2
    echo "deliberately with: git commit --no-verify" >&2
    violations=1
fi

# --- 2. Generated disassembly is never edited, only regenerated -------------
asm_hits="$(git diff --cached --name-status | grep -E '^[MD]\s+asm/' || true)"
if [ -n "$asm_hits" ]; then
    # A commit that also changes the generator or the segmentation config is
    # a regeneration commit (scan/split refinement) - allowed. A commit that
    # touches asm/ alone is a hand edit - blocked.
    regen_hits="$(git diff --cached --name-only | \
                 grep -E '^(tools/scan_functions\.py|tools/gen_ld\.py|config/splat\.[^.]+\.yaml|config/symbols\.[^.]+\.txt)$' || true)"
    if [ -z "$regen_hits" ]; then
        echo "ERROR: this commit modifies or deletes generated disassembly:" >&2
        echo "$asm_hits" | sed 's/^/  /' >&2
        echo "" >&2
        echo "asm/ is regenerated by splat (make extract). Hand edits are" >&2
        echo "silently overwritten and corrupt the oracle." >&2
        echo "" >&2
        echo "To rename a symbol, edit config/symbols.*.txt (through a rename" >&2
        echo "tool, never by hand) and re-extract. To change segmentation, edit" >&2
        echo "config/splat.*.yaml and re-scan/re-split; commit the generator or" >&2
        echo "config change together with the regenerated files." >&2
        violations=1
    fi
fi

# --- 3. Source-only policy: no copyrighted material, ever --------------------
# (.gitignore / .gitkeep inside those directories are bookkeeping, not data)
copyright_hits="$(git diff --cached --name-only | \
                  grep -E '^(disk/|sdk/|lib/|include/psyq/|assets/|baselines/)' | \
                  grep -vE '/(\.gitignore|\.gitkeep)$' || true)"
if [ -n "$copyright_hits" ]; then
    echo "ERROR: this commit adds files from a git-ignored (copyrighted) area:" >&2
    echo "$copyright_hits" | sed 's/^/  /' >&2
    echo "" >&2
    echo "This repository contains no game data and no Sony files. The disc," >&2
    echo "the SDK and the retail executable stay on your machine." >&2
    violations=1
fi

# --- 4. Agent sessions commit as the agent, never as the owner ---------------
# The owner's GitHub noreply address links a commit to their account, and the
# ambient global git config hands it to every session that sets no identity of
# its own. ZCode exports the markers below to every process it spawns, so an
# agent-driven commit carries them and the owner's own terminal does not.
#
# CAVEAT: if ZCode ever renames these markers the check stops firing, and agent
# commits silently revert to the owner's identity. Re-verify this list after a
# client upgrade.
OWNER_EMAIL='16026653+s-ilent@users.noreply.github.com'
agent_session=0
for marker in "$ZCODE_ENV" "$ZCODE_APP_VERSION" "$ZCODE_BASE_URL" "$ZCODE_PROCESS_LABEL"; do
    if [ -n "$marker" ]; then agent_session=1; fi
done
case "${APPIMAGE:-}${APPDIR:-}" in *ZCode*) agent_session=1 ;; esac
if [ "$agent_session" = 1 ] && [ "${ALLOW_OWNER_IDENT:-}" != "1" ]; then
    owner_hit=0
    for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
        case "$ident" in *"$OWNER_EMAIL"*) owner_hit=1 ;; esac
    done
    if [ "$owner_hit" = 1 ]; then
        echo "ERROR: an agent session is committing under the repository owner's name:" >&2
        echo "  author:    $(git var GIT_AUTHOR_IDENT)" >&2
        echo "  committer: $(git var GIT_COMMITTER_IDENT)" >&2
        echo "" >&2
        echo "Agent commits carry the agent identity; the owner's name must never" >&2
        echo "appear on work an agent performed. Commit with:" >&2
        echo "  sh tools/agent_git.sh commit -m '<message>'" >&2
        echo "Both identities are checked: setting only GIT_AUTHOR_NAME/EMAIL" >&2
        echo "leaves the committer as the owner and still fails." >&2
        echo "" >&2
        echo "Only if the owner is the one committing from inside this session:" >&2
        echo "  ALLOW_OWNER_IDENT=1 git commit ..." >&2
        violations=1
    fi
fi

exit $violations
