# =============================================================================
# psx-decomp-template — build orchestration
#
# Methodology, distilled from tenchu-decomp, lsddecomp, parasite-eve-decomp
# and rage-racer-decomp:
#
#   * A bare `make` is deliberately blocked. A bare build says nothing about
#     whether the bytes are right. The only build entrance is `make verify`,
#     which builds AND compares the whole image with the retail executable.
#   * The retail SHA-1 in config/sha1/ is the oracle. It is never edited.
#   * Everything marked FILL must be adapted to your game before use.
#     Find them all with:  grep -rn "FILL:" .
# =============================================================================

MAKEFLAGS += --no-builtin-rules
.SUFFIXES:

# --- Names to fill in -------------------------------------------------------
# Galaxian^3 is a multi-EXE game: eight targets across two regions (see
# docs/RECON.md). Every address in every config is valid for exactly ONE of
# them; the primary target is the Japan boot executable.
TARGET       ?= slps_00270
BASELINE     ?= baselines/$(TARGET).bin
BUILD_DIR    ?= build
SHA1_FILE    ?= config/sha1/$(TARGET).sha1
SPLAT_CONFIG ?= config/splat.$(TARGET).yaml

PY ?= python3

# --- Bare-make guard --------------------------------------------------------
# LSD rule 2, generalised: every build goes through the oracle gate. The hook
# installed by `make hooks` blocks in-repo `make` except the targets listed
# here (extract, progress, nonmatchings, ratchets, hooks, clean) — none of
# which produce a byte.
.DEFAULT_GOAL := _bare-make-blocked

.PHONY: _bare-make-blocked
_bare-make-blocked:
	@echo "ERROR: bare 'make' is deliberately blocked."
	@echo "A bare build produces bytes but says nothing about whether they are right."
	@echo ""
	@echo "  make verify TARGET=<t>    build + compare the whole image with retail"
	@echo "  make extract TARGET=<t>   split the retail executable (splat)"
	@echo "  make progress             matched / nonmatching function report"
	@echo "  make nonmatchings         list functions that do not match yet"
	@echo "  make ratchets             placeholder / debt ratchet audit"
	@echo "  make hooks                install git hooks that protect the oracle"
	@echo "  make clean                remove the build directory"
	@echo ""
	@echo "  Targets: slps_00270 sces_00269 mainmenu_jp mainmenu_eu"
	@echo "           g3_jp g3_eu g3org_jp g3org_eu"
	@exit 1

# --- The oracle gate --------------------------------------------------------
.PHONY: verify
verify:
	./tools/verify.sh "$(TARGET)"

# --- Build pipeline ---------------------------------------------------------
# FILL: this is where your pinned toolchain runs. The community-default
# pipeline for PSX matching decompilation is:
#
#   old GCC cc1 (exact revision your game used) -> maspsx (Sony ASPSX
#   behaviour for GNU as) -> binutils -> linker script generated by splat
#   -> PS-X EXE.
#
# Prebuilt historical compilers live in decompme/compilers and
# decompals/old-gcc. See docs/CHECKLIST.md steps 3-6 and
# docs/REFERENCES.md for pointers.
.PHONY: build
build:
	@echo "FILL: implement the compile pipeline (target 'build' in the Makefile,"
	@echo "      or a script called from tools/verify.sh). Pin the exact original"
	@echo "      compiler revision — the compiler is part of the retail bytes."
	@exit 2

# --- Split the retail executable --------------------------------------------
# Runs splat over your (git-ignored) executable and generates asm/, data,
# linker script and symbol lists. Commit the generated asm/ and config/,
# never the binary. See config/splat.$(TARGET).yaml.
.PHONY: extract
extract:
	$(PY) -m splat split $(SPLAT_CONFIG)

# --- Measure the load maps ---------------------------------------------------
# Regenerates docs/LOADMAP.md from the git-ignored baselines: header
# invariants, per-target RAM map, entry disassembly. Needs capstone.
.PHONY: map
map:
	$(PY) tools/exe_map.py

# --- Measurement ------------------------------------------------------------
# Project state lives in tools, never in prose. A number written in a
# document is right for one session and wrong for every one after.
.PHONY: progress
progress:
	$(PY) tools/progress.py

.PHONY: nonmatchings
nonmatchings:
	$(PY) tools/progress.py --list

.PHONY: ratchets
ratchets:
	$(PY) tools/check_ratchets.py

# --- Hooks ------------------------------------------------------------------
# Installs .githooks/pre-commit as the repo's hook path: it blocks edits to
# config/sha1/ (the oracle) and to tracked asm/ files (splat regenerates
# them). Run once after cloning.
.PHONY: hooks
hooks:
	git config core.hooksPath .githooks
	@echo "hooks installed: config/sha1/ and tracked asm/ are now protected"

# --- Clean ------------------------------------------------------------------
.PHONY: clean
clean:
	rm -rf $(BUILD_DIR)
