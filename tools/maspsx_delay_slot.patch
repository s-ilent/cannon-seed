+def line_redefines_reg(line: str, r_dest: str) -> bool:
+    """True when the instruction WRITES r_dest as its destination register
+    (ALU/immediate/la/li/move forms - first operand = dest). Stores, branches
+    and loads name sources or belong to line_loads_from_reg's aligned-load
+    rule, so they are excluded: the lwl/lwr pair is the unaligned-word shape
+    (lwr re-writing lwl's dest is the pair itself, not a reuse hazard - the
+    aspsx pad lands between lwr and its first USE, witnessed on the
+    CD_newmedia lba copy, cron-20261101-2033)."""
+    line = strip_comments(line)
+    match = re.match(r"^([A-z][A-z0-9]*)\s+(.*)$", line)
+    if not match:
+        return False
+    op, rest = match.group(1, 2)
+    if op in store_mnemonics or op in branch_mnemonics or op in jump_mnemonics:
+        return False
+    if op == "jal":
+        return False
+    if op in load_mnemonics:
+        return False
+    first_operand = rest.split(",")[0].strip()
+    return first_operand == r_dest
+
+
+def is_far_store_of_reg(line: str, r_source: str) -> bool:
+    """True when line stores r_source's value to a bare-symbol address (the
+    far-store class: `sw $2,D_800C8028` - no base register, no %lo). The
+    assembler at-expands it into `lui $at,%hi(sym)` + `sw ...,%lo(sym)($at)`,
+    so the data use lands at prefix+1. ASPSX's pipeline keeps cc1's hazard
+    nop for this pair even though the prefix pushes the use past the single
+    load-delay slot (func_8007736C's mount-guard copy `lw $2,D_800C7CFC;
+    nop; sw $2,D_800C8028`, cron-202611021158/202611021204) - the numeric
+    big-offset base form (`sw $2,56200($4)`) is a different expansion path
+    and is NOT covered here (no empirical instance)."""
+    line = strip_comments(line)
+    r_source = r_source.replace("$", r"\$")
+    # e.g. sw  $2,D_800C8028   /  sw  $2,g_CurrentRoom+40  /  sb $2,D_x.4
+    match = re.match(
+        r"^s(?:[wbh]|w[lr])\s+(" + r_source + r"),\s*(-?[A-Za-z0-9_.+]+)$", line
+    )
+    if match:
+        operand = match.group(2)
+        if not is_number(operand):
+            return True
+    return False
+
